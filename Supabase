-- Public user profiles linked to Supabase Auth
create table profiles (
  id uuid references auth.users primary key,
  username text unique not null,
  avatar_url text,
  bio text,
  created_at timestamp with time zone default timezone('utc'::text, now())
);

-- Master directory of signers/players
create table signers (
  id uuid primary key default gen_random_uuid(),
  name text not null,
  sport_team text,
  active_address text,
  success_rate numeric default 0,
  avg_days_return integer default 0
);

-- User TTM logs (Feeds public signer stats)
create table ttm_logs (
  id uuid primary key default gen_random_uuid(),
  user_id uuid references profiles(id) on delete cascade,
  signer_id uuid references signers(id),
  sent_date date not null,
  returned_date date,
  status text check (status in ('Pending', 'Success', 'RTS', 'Fee Required')),
  is_public boolean default true,
  notes text
);

-- Vault items & Marketplace listings
create table vault_items (
  id uuid primary key default gen_random_uuid(),
  user_id uuid references profiles(id) on delete cascade,
  title text not null,
  category text,
  grade text,
  is_for_sale boolean default false,
  is_for_trade boolean default false,
  price numeric,
  image_url text
);
-- 1. Enable Row Level Security on your existing tables
alter table ttm_logs enable row level security;
alter table vault_items enable row level security;

-- 2. TTM LOGS POLICIES
-- Anyone (even logged-out users) can view public TTM entries for the directory
create policy "Public TTM entries are viewable by everyone" 
on ttm_logs for select 
using (is_public = true);

-- Users can insert their own TTM logs
create policy "Users can insert their own TTM logs" 
on ttm_logs for insert 
with check (auth.uid() = user_id);

-- Users can update/delete only their own TTM logs
create policy "Users can update their own TTM logs" 
on ttm_logs for update 
using (auth.uid() = user_id);

-- 3. VAULT ITEMS POLICIES
-- Anyone can view items marked for sale or trade in the marketplace
create policy "Marketplace items are viewable by everyone" 
on vault_items for select 
using (is_for_sale = true or is_for_trade = true or auth.uid() = user_id);

-- Users can manage their own vault items
create policy "Users can manage their own vault items" 
on vault_items for all 
using (auth.uid() = user_id);
