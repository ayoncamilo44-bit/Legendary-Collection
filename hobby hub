<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hobby Hub | Legendary Collection</title>
    <meta name="description" content="A curated directory of card protection, boxes, sealed wax, postage, and checklist and price databases for TTM sports card collectors.">
    <link rel="canonical" href="https://ayoncamilo44-bit.github.io/Legendary-Collection/hobby-hub.html">
    <link rel="icon" href="./favicon.svg" type="image/svg+xml">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Legendary Collection">
    <meta property="og:title" content="Hobby Hub | Legendary Collection">
    <meta property="og:description" content="Hobby supplies, retailers, and card databases for TTM collectors.">
    <meta property="og:url" content="https://ayoncamilo44-bit.github.io/Legendary-Collection/hobby-hub.html">
    <meta property="og:image" content="https://ayoncamilo44-bit.github.io/Legendary-Collection/assets/legitimate-collector-social.png">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        :root { --bg:#05070d; --panel:#0b111c; --card:#0d1421; --line:#1a2333; --text:#e8edf7; --muted:#94a1b8; --gold:#fbbf24; --gold2:#f59e0b; }
        * { box-sizing:border-box; }
        [hidden] { display:none !important; }
        body { margin:0; background:var(--bg); color:var(--text); font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,sans-serif; line-height:1.5; }
        a { color:inherit; text-decoration:none; }
        .wrap { max-width:1180px; margin:0 auto; padding:0 20px; }
        i[data-lucide], svg.lucide { width:16px; height:16px; display:inline-block; vertical-align:middle; }

        /* header */
        .top { position:sticky; top:0; z-index:20; background:rgba(5,7,13,.92); backdrop-filter:blur(10px); border-bottom:1px solid var(--line); }
        .top .wrap { display:flex; align-items:center; justify-content:space-between; gap:12px; padding-top:12px; padding-bottom:12px; flex-wrap:wrap; }
        .brand { display:flex; align-items:center; gap:12px; min-width:0; }
        .brand-mark { width:44px; height:52px; border-radius:12px; background:linear-gradient(160deg,#fcd34d,#f59e0b); display:grid; place-items:center; color:#1c1400; box-shadow:0 6px 20px rgba(251,191,36,.28); flex:none; }
        .brand-mark svg { width:22px; height:22px; }
        .brand-name { font-weight:900; font-size:22px; letter-spacing:.02em; white-space:nowrap; }
        .brand-name b { color:var(--gold); font-weight:900; }
        .badge { margin-left:4px; padding:3px 10px; font-size:12px; font-weight:700; color:var(--gold); border:1px solid rgba(251,191,36,.45); border-radius:999px; background:rgba(251,191,36,.08); }
        .actions { display:flex; gap:10px; }
        .btn { display:inline-flex; align-items:center; gap:8px; padding:9px 14px; border-radius:10px; font-weight:700; font-size:13px; border:1px solid var(--line); background:#121a29; color:var(--text); cursor:pointer; font-family:inherit; }
        .btn:hover { background:#18223a; }
        .btn.gold { background:var(--gold); color:#1c1400; border-color:transparent; box-shadow:0 6px 18px rgba(251,191,36,.25); }
        .btn.gold:hover { background:var(--gold2); }

        /* hero */
        .hero { margin-top:36px; padding:48px; border:1px solid var(--line); border-radius:24px; background:radial-gradient(900px 400px at 85% 60%, rgba(251,191,36,.12), transparent 60%), var(--panel); }
        .pill-label { display:inline-flex; align-items:center; gap:8px; padding:6px 14px; font-size:13px; font-weight:700; color:var(--gold); border:1px solid rgba(251,191,36,.4); border-radius:999px; background:rgba(251,191,36,.08); }
        .hero h1 { margin:18px 0 12px; font-size:clamp(30px,5vw,46px); line-height:1.1; font-weight:800; letter-spacing:-.02em; }
        .hero p.lead { margin:0 0 24px; max-width:880px; font-size:19px; color:#c3cde0; }
        .notice { display:flex; gap:12px; align-items:flex-start; max-width:890px; padding:14px 18px; border:1px solid var(--line); border-radius:14px; background:rgba(8,12,20,.7); font-size:13.5px; color:#b8c3d8; }
        .notice i { color:var(--gold); margin-top:2px; flex:none; }
        .notice b { color:#fff; }

        /* toolbar */
        .toolbar { margin-top:36px; padding:18px; border:1px solid var(--line); border-radius:20px; background:var(--panel); display:flex; flex-wrap:wrap; gap:14px; align-items:center; justify-content:space-between; }
        .search { position:relative; flex:1 1 320px; max-width:445px; }
        .search i { position:absolute; left:14px; top:50%; transform:translateY(-50%); color:var(--muted); width:18px; height:18px; }
        .search input { width:100%; padding:13px 14px 13px 44px; border-radius:12px; border:1px solid var(--line); background:#0a1019; color:var(--text); font:inherit; font-size:15px; }
        .search input:focus { outline:2px solid rgba(251,191,36,.55); outline-offset:1px; }
        .pills { display:flex; flex-wrap:wrap; gap:10px; }
        .pill { padding:10px 18px; border-radius:999px; border:1px solid var(--line); background:#121a29; color:#d8e0ef; font:inherit; font-size:13px; font-weight:700; cursor:pointer; }
        .pill:hover { background:#18223a; }
        .pill.active { background:var(--gold); color:#1c1400; border-color:transparent; box-shadow:0 6px 18px rgba(251,191,36,.25); }

        /* sections + cards */
        .res-section { margin-top:44px; }
        .sec-head { display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; padding-bottom:14px; border-bottom:1px solid var(--line); }
        .sec-title { display:flex; align-items:center; gap:14px; }
        .sec-title h2 { margin:0; font-size:24px; font-weight:800; letter-spacing:-.01em; }
        .sec-ic { width:36px; height:36px; border-radius:10px; display:grid; place-items:center; border:1px solid; }
        .sec-ic i { width:18px; height:18px; }
        .s-blue { color:#60a5fa; background:rgba(59,130,246,.12); border-color:rgba(59,130,246,.35); }
        .s-green { color:#34d399; background:rgba(16,185,129,.12); border-color:rgba(16,185,129,.35); }
        .s-purple { color:#c084fc; background:rgba(168,85,247,.12); border-color:rgba(168,85,247,.35); }
        .sec-sub { font-size:13px; color:var(--muted); }
        .grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(250px,1fr)); gap:20px; margin-top:20px; }
        .res-card { display:flex; flex-direction:column; padding:22px; border:1px solid var(--line); border-radius:20px; background:linear-gradient(180deg,#0e1523,#0b111c); }
        .res-card:hover { border-color:#2a3850; transform:translateY(-2px); transition:all .2s; }
        .card-top { display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; }
        .card-ic { color:#8a97ae; width:18px; height:18px; }
        .tag { padding:4px 10px; font-size:11px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; border-radius:6px; border:1px solid; }
        .t-blue { color:#60a5fa; background:rgba(59,130,246,.12); border-color:rgba(59,130,246,.3); }
        .t-green { color:#34d399; background:rgba(16,185,129,.12); border-color:rgba(16,185,129,.3); }
        .t-purple { color:#c084fc; background:rgba(168,85,247,.12); border-color:rgba(168,85,247,.3); }
        .res-card h3 { margin:0 0 8px; font-size:18px; font-weight:800; }
        .res-card p { margin:0 0 20px; color:var(--muted); font-size:14px; line-height:1.65; flex:1; }
        .visit { display:flex; align-items:center; justify-content:center; gap:8px; padding:12px; border-radius:12px; border:1px solid var(--line); background:#192233; color:#fff; font-size:13.5px; font-weight:700; }
        .visit:hover { background:#222e45; border-color:#34425d; }
        .empty { margin-top:40px; padding:40px; text-align:center; color:var(--muted); border:1px dashed var(--line); border-radius:20px; }
        footer { margin-top:70px; padding:28px 0; border-top:1px solid var(--line); text-align:center; font-size:13.5px; color:var(--muted); }
        footer b { color:#fff; }
        @media (max-width:640px) { .hero { padding:28px 22px; } .brand-name { font-size:18px; } }
    </style>
</head>
<body>
    <header class="top">
        <div class="wrap">
            <a class="brand" href="hobby-hub.html" aria-label="Legendary Collection Hobby Hub">
                <span class="brand-mark"><i data-lucide="award" aria-hidden="true"></i></span>
                <span class="brand-name">LEGENDARY<b>COLLECTION</b></span>
                <span class="badge">Hobby Hub</span>
            </a>
            <div class="actions">
                <button type="button" class="btn" id="shareHub"><i data-lucide="share-2" aria-hidden="true"></i><span id="shareLabel">Share Hub</span></button>
                <a class="btn gold" href="index.html"><i data-lucide="house" aria-hidden="true"></i>Main App</a>
            </div>
        </div>
    </header>

    <main class="wrap">
        <section class="hero">
            <span class="pill-label"><i data-lucide="shield-check" aria-hidden="true"></i>Verified Collectors Directory</span>
            <h1>Hobby Supplies &amp; Trusted Retailers</h1>
            <p class="lead">Your curated directory for card protection, boxes, sealed wax, and authenticating databases. Hand-selected resources to keep your TTM collection organized and safe.</p>
            <div class="notice"><i data-lucide="info" aria-hidden="true"></i><span><b>Collector Transparency:</b> Some retailer links may contain referral codes that help fund Legendary Collection's database servers at zero extra cost to you.</span></div>
        </section>

        <div class="toolbar">
            <label class="search"><i data-lucide="search" aria-hidden="true"></i><span style="position:absolute;left:-9999px">Search resources</span><input type="search" id="hubSearch" placeholder="Search retailers, supplies, databases..." autocomplete="off"></label>
            <div class="pills" role="group" aria-label="Filter resources">
                <button type="button" class="pill active" data-filter="all" aria-pressed="true">All Resources (12)</button>
                <button type="button" class="pill" data-filter="retailers" aria-pressed="false">Retailers (4)</button>
                <button type="button" class="pill" data-filter="supplies" aria-pressed="false">Supplies (4)</button>
                <button type="button" class="pill" data-filter="databases" aria-pressed="false">Databases (4)</button>
            </div>
        </div>

        <section class="res-section" data-cat="retailers" aria-labelledby="h-retailers">
            <div class="sec-head">
                <div class="sec-title"><span class="sec-ic s-blue"><i data-lucide="store" aria-hidden="true"></i></span><h2 id="h-retailers">Trusted Retailers &amp; Box Breakers</h2></div>
                <span class="sec-sub">Sealed Hobby Boxes &amp; Singles</span>
            </div>
            <div class="grid">
            <article class="res-card" data-cat="retailers">
                <div class="card-top"><span class="tag t-blue">Boxes &amp; Cases</span><i data-lucide="package" class="card-ic" aria-hidden="true"></i></div>
                <h3>Steel City Collectibles</h3>
                <p>Premier online sports card shop for hobby boxes, break slots, and trading card singles.</p>
                <a class="visit" href="https://www.steelcitycollectibles.com/" target="_blank" rel="noopener noreferrer">Visit Official Site <i data-lucide="external-link" aria-hidden="true"></i></a>
            </article>
            <article class="res-card" data-cat="retailers">
                <div class="card-top"><span class="tag t-blue">Boxes &amp; Breakers</span><i data-lucide="store" class="card-ic" aria-hidden="true"></i></div>
                <h3>Dave &amp; Adam&#x27;s Card World</h3>
                <p>One of the largest hobby distributors offering unopened boxes, autographed memorabilia, and supplies.</p>
                <a class="visit" href="https://www.dacardworld.com/" target="_blank" rel="noopener noreferrer">Visit Official Site <i data-lucide="external-link" aria-hidden="true"></i></a>
            </article>
            <article class="res-card" data-cat="retailers">
                <div class="card-top"><span class="tag t-blue">Hobby Boxes</span><i data-lucide="flame" class="card-ic" aria-hidden="true"></i></div>
                <h3>Blowout Cards</h3>
                <p>Major sports card distributor known for competitive pre-orders and active collector forums.</p>
                <a class="visit" href="https://www.blowoutcards.com/" target="_blank" rel="noopener noreferrer">Visit Official Site <i data-lucide="external-link" aria-hidden="true"></i></a>
            </article>
            <article class="res-card" data-cat="retailers">
                <div class="card-top"><span class="tag t-blue">Singles Marketplace</span><i data-lucide="tag" class="card-ic" aria-hidden="true"></i></div>
                <h3>COMC (Check Out My Cards)</h3>
                <p>Consignment marketplace for buying and selling individual singles at fixed prices with flat shipping.</p>
                <a class="visit" href="https://www.comc.com/" target="_blank" rel="noopener noreferrer">Visit Official Site <i data-lucide="external-link" aria-hidden="true"></i></a>
            </article>
            </div>
        </section>
        <section class="res-section" data-cat="supplies" aria-labelledby="h-supplies">
            <div class="sec-head">
                <div class="sec-title"><span class="sec-ic s-green"><i data-lucide="archive" aria-hidden="true"></i></span><h2 id="h-supplies">Protection &amp; Hobby Supplies</h2></div>
                <span class="sec-sub">TTM Mailing &amp; Storage Essentials</span>
            </div>
            <div class="grid">
            <article class="res-card" data-cat="supplies">
                <div class="card-top"><span class="tag t-green">Protection</span><i data-lucide="shield" class="card-ic" aria-hidden="true"></i></div>
                <h3>BCW Supplies</h3>
                <p>Industry-standard card holders, penny sleeves, top loaders, and specialized TTM mailers.</p>
                <a class="visit" href="https://www.bcwsupplies.com/" target="_blank" rel="noopener noreferrer">Visit Official Site <i data-lucide="external-link" aria-hidden="true"></i></a>
            </article>
            <article class="res-card" data-cat="supplies">
                <div class="card-top"><span class="tag t-green">Top Loaders &amp; Cases</span><i data-lucide="gem" class="card-ic" aria-hidden="true"></i></div>
                <h3>Ultra PRO Entertainment</h3>
                <p>Official manufacturer of ONE-TOUCH magnetic holders, sleeves, binders, and display pages.</p>
                <a class="visit" href="https://www.ultrapro.com/" target="_blank" rel="noopener noreferrer">Visit Official Site <i data-lucide="external-link" aria-hidden="true"></i></a>
            </article>
            <article class="res-card" data-cat="supplies">
                <div class="card-top"><span class="tag t-green">Grading Supplies</span><i data-lucide="layers" class="card-ic" aria-hidden="true"></i></div>
                <h3>Cardboard Gold</h3>
                <p>Specialized grading submission sleeves, Saver 1 holders, and bulk storage solutions.</p>
                <a class="visit" href="https://www.cardboardgold.com/" target="_blank" rel="noopener noreferrer">Visit Official Site <i data-lucide="external-link" aria-hidden="true"></i></a>
            </article>
            <article class="res-card" data-cat="supplies">
                <div class="card-top"><span class="tag t-green">TTM Postage</span><i data-lucide="mail" class="card-ic" aria-hidden="true"></i></div>
                <h3>USPS Postal Store</h3>
                <p>Order Forever stamps and return postage directly for your TTM self-addressed stamped envelopes (SASE).</p>
                <a class="visit" href="https://store.usps.com/" target="_blank" rel="noopener noreferrer">Visit Official Site <i data-lucide="external-link" aria-hidden="true"></i></a>
            </article>
            </div>
        </section>
        <section class="res-section" data-cat="databases" aria-labelledby="h-databases">
            <div class="sec-head">
                <div class="sec-title"><span class="sec-ic s-purple"><i data-lucide="database" aria-hidden="true"></i></span><h2 id="h-databases">Card Databases &amp; Checklists</h2></div>
                <span class="sec-sub">Set Lists &amp; Market Values</span>
            </div>
            <div class="grid">
            <article class="res-card" data-cat="databases">
                <div class="card-top"><span class="tag t-purple">Checklists &amp; TTM</span><i data-lucide="list-checks" class="card-ic" aria-hidden="true"></i></div>
                <h3>TCDB (Trading Card Database)</h3>
                <p>Crowdsourced checklist database, trade manager, and TTM address log for sports card collectors.</p>
                <a class="visit" href="https://www.tcdb.com/" target="_blank" rel="noopener noreferrer">Visit Official Site <i data-lucide="external-link" aria-hidden="true"></i></a>
            </article>
            <article class="res-card" data-cat="databases">
                <div class="card-top"><span class="tag t-purple">Price Guide</span><i data-lucide="trending-up" class="card-ic" aria-hidden="true"></i></div>
                <h3>130 Point Sales Search</h3>
                <p>Real-time market value search engine fetching eBay accepted best-offer prices and auction sales.</p>
                <a class="visit" href="https://130point.com/sales/" target="_blank" rel="noopener noreferrer">Visit Official Site <i data-lucide="external-link" aria-hidden="true"></i></a>
            </article>
            <article class="res-card" data-cat="databases">
                <div class="card-top"><span class="tag t-purple">Autograph Lookup</span><i data-lucide="badge-check" class="card-ic" aria-hidden="true"></i></div>
                <h3>PSA Cert Verification</h3>
                <p>Verify PSA slab certification numbers and check population reports for graded cards and autographs.</p>
                <a class="visit" href="https://www.psacard.com/cert" target="_blank" rel="noopener noreferrer">Visit Official Site <i data-lucide="external-link" aria-hidden="true"></i></a>
            </article>
            <article class="res-card" data-cat="databases">
                <div class="card-top"><span class="tag t-purple">Registry &amp; Values</span><i data-lucide="book-marked" class="card-ic" aria-hidden="true"></i></div>
                <h3>Beckett Online Price Guide</h3>
                <p>Comprehensive set database and official Beckett grading/autograph authentication registry.</p>
                <a class="visit" href="https://www.beckett.com/" target="_blank" rel="noopener noreferrer">Visit Official Site <i data-lucide="external-link" aria-hidden="true"></i></a>
            </article>
            </div>
        </section>

        <div class="empty" id="hubEmpty" hidden>No resources match your search. Try a different word or clear the filter.</div>
    </main>

    <footer>
        <div class="wrap">&copy; 2026 <b>Legendary Collection</b>. Built for TTM sports collectors. All external trademarks belong to their respective owners.</div>
    </footer>

    <script>
    (function () {
        var cards = [].slice.call(document.querySelectorAll('.res-card'));
        var sections = [].slice.call(document.querySelectorAll('.res-section'));
        var pills = [].slice.call(document.querySelectorAll('.pill'));
        var search = document.getElementById('hubSearch');
        var empty = document.getElementById('hubEmpty');
        var cat = 'all';

        function apply() {
            var q = search.value.trim().toLowerCase();
            var shown = 0;
            cards.forEach(function (c) {
                var ok = (cat === 'all' || c.getAttribute('data-cat') === cat) && (!q || c.textContent.toLowerCase().indexOf(q) > -1);
                c.hidden = !ok;
                if (ok) shown++;
            });
            sections.forEach(function (s) { s.hidden = !s.querySelector('.res-card:not([hidden])'); });
            empty.hidden = shown !== 0;
        }
        pills.forEach(function (p) {
            p.addEventListener('click', function () {
                cat = p.getAttribute('data-filter');
                pills.forEach(function (x) {
                    var on = x === p;
                    x.classList.toggle('active', on);
                    x.setAttribute('aria-pressed', String(on));
                });
                apply();
            });
        });
        search.addEventListener('input', apply);

        var shareBtn = document.getElementById('shareHub');
        var label = document.getElementById('shareLabel');
        shareBtn.addEventListener('click', function () {
            var url = location.href;
            if (navigator.share) {
                navigator.share({ title: document.title, url: url }).catch(function () {});
            } else if (navigator.clipboard) {
                navigator.clipboard.writeText(url).then(function () {
                    label.textContent = 'Link copied';
                    setTimeout(function () { label.textContent = 'Share Hub'; }, 2000);
                });
            }
        });

        if (typeof lucide !== 'undefined') lucide.createIcons();
    })();
    </script>
</body>
</html>
